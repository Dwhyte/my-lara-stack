{
    "$schema": "https://schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "concurrently -k -n vite,reverb,queue -c blue,green,yellow \"vite\" \"bash scripts/reverb-dev.sh\" \"bash scripts/queue-dev.sh\"",
        "dev:herd": "concurrently -k -n vite,queue -c blue,yellow \"vite\" \"bash scripts/queue-dev.sh\"",
        "dev:vite": "vite",
        "dev:reverb": "php artisan reverb:start",
        "dev:queue": "bash scripts/queue-dev.sh",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@fontsource/inter": "^5.2.8",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@nuxt/ui": "^4.1.0",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^3.0.0",
        "pusher-js": "^8.6.0",
        "tailwindcss": "^4.1.1",
        "vue": "^3.5.24"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/eslint-config-typescript": "^14.6.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^10.5.1",
        "globals": "^17.12.0",
        "playwright": "^1.63.0",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^8.0.0",
        "vue-tsc": "^3.1.3"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
